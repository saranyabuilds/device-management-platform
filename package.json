  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9.15.9"
  },
  "scripts": {
    "start:web": "nx serve web-admin",
    "start:device-api": "nx serve device-api",
    "start:firmware-api": "nx serve firmware-api",
    "start:ota": "nx serve ota-update-service",
    "build": "nx run-many -t build --all",
    "test": "nx run-many -t test --all",
    "lint": "nx run-many -t lint --all",
    "affected:build": "nx affected -t build",
    "affected:test": "nx affected -t test",
    "affected:lint": "nx affected -t lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml,yaml}": "prettier --write",
    "*.{ts,js}": "eslint --fix"
