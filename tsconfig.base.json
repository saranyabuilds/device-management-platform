{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@device-management-platform/shared-types": ["./libs/shared-types/src/index.ts"],
      "@device-management-platform/shared-utils": ["./libs/shared-utils/src/index.ts"],
      "@device-management-platform/logging": ["./libs/logging/src/index.ts"],
      "@device-management-platform/validation": ["./libs/validation/src/index.ts"],
      "@device-management-platform/auth": ["./libs/auth/src/index.ts"],
      "@device-management-platform/device-domain": ["./libs/device-domain/src/index.ts"],
      "@device-management-platform/firmware-domain": ["./libs/firmware-domain/src/index.ts"],
      "@device-management-platform/telemetry-domain": ["./libs/telemetry-domain/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
