# Local-only development defaults. Copy this file to .env and adjust as needed.
# Do not use these values in shared or production environments.

POSTGRES_DB=device_management
POSTGRES_USER=dmp_user
POSTGRES_PASSWORD=dmp_password
POSTGRES_PORT=5432

REDIS_PORT=6379

KAFKA_PORT=9094
KAFKA_KRAFT_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

MQTT_PORT=1883
MQTT_WEBSOCKET_PORT=9001
EMQX_MQTT_PORT=1884
EMQX_MQTT_TLS_PORT=8883
EMQX_WEBSOCKET_PORT=8083
EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=public-emqx-local-admin-change-me
EMQX_NODE_COOKIE=device-management-emqx-local-cookie
EMQX_SESSION_EXPIRY_INTERVAL=2h
EMQX_MQTT_MAX_PACKET_SIZE=1MB

LOKI_PORT=3100
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
KAFKA_EXPORTER_PORT=9308
MQTT_EXPORTER_PORT=9234
JAEGER_UI_PORT=16686
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
TRACING_ENABLED=true
TRACING_SAMPLING_PROBABILITY=1.0
OTEL_SERVICE_NAME=device-api
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://jaeger:4318/v1/traces
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

DEVICE_API_PORT=8080
DEVICE_API_PROFILE=local

JWT_ISSUER=device-api
JWT_SECRET=local-development-jwt-secret-change-me-32-bytes-minimum
JWT_ACCESS_TOKEN_TTL=15m
JWT_CLOCK_SKEW=30s
REFRESH_TOKEN_TTL=7d

OAUTH2_CLIENT_ID=device-api-local
OAUTH2_CLIENT_SECRET=local-oauth2-client-secret
OAUTH2_AUTHORIZATION_URI=http://localhost:8081/realms/device-management/protocol/openid-connect/auth
OAUTH2_TOKEN_URI=http://localhost:8081/realms/device-management/protocol/openid-connect/token
OAUTH2_JWK_SET_URI=http://localhost:8081/realms/device-management/protocol/openid-connect/certs
OAUTH2_USER_INFO_URI=http://localhost:8081/realms/device-management/protocol/openid-connect/userinfo
OAUTH2_USER_NAME_ATTRIBUTE=sub

PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

DEVICE_SERIAL_MIN_LENGTH=6
DEVICE_SERIAL_MAX_LENGTH=64
DEVICE_SERIAL_ALLOWED_PATTERN=^[A-Z0-9][A-Z0-9-]*$
DEVICE_CERTIFICATE_ISSUER_NAME=Device Management Local CA
DEVICE_CERTIFICATE_ISSUER_ID=urn:device-management:local-ca
DEVICE_CERTIFICATE_VALIDITY=365d
DEVICE_HEARTBEAT_TOPIC=devices/{serialNumber}/heartbeat
DEVICE_HEARTBEAT_TIMEOUT=5m
DEVICE_HEARTBEAT_SCHEDULER_ENABLED=true

ADMIN_USER_ID=admin
ADMIN_USER_EMAIL=admin@example.com
ADMIN_USER_DISPLAY_NAME=Platform Admin
ADMIN_USER_PASSWORD=ChangeMe123!
OPERATOR_USER_ID=operator
OPERATOR_USER_EMAIL=operator@example.com
OPERATOR_USER_DISPLAY_NAME=Platform Operator
OPERATOR_USER_PASSWORD=ChangeMe123!
VIEWER_USER_ID=viewer
VIEWER_USER_EMAIL=viewer@example.com
VIEWER_USER_DISPLAY_NAME=Platform Viewer
VIEWER_USER_PASSWORD=ChangeMe123!

ADMIN_PORTAL_PORT=4200
